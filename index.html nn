  });

  wireBotControls();
}

function botField(id, label, type, value, options) {
  let input;
  if (type === 'select') {
    input = '<select id="' + id + '">' + options.map(([v, l]) =>
      '<option value="' + v + '"' + (v === value ? ' selected' : '') + '>' + l + '</option>'
    ).join('') + '</select>';
  } else {
    input = '<input type="number" step="any" id="' + id + '" value="' + value + '">';
  }
  return '<label class="bs-field"><span>' + label + '</span>' + input + '</label>';
}

function wireBotControls() {
  const save = document.getElementById('botSave');
  if (save) save.addEventListener('click', () => {
    const s = loadBot();
    const num = (id, fallback) => {
      const v = parseFloat(document.getElementById(id).value);
      return isFinite(v) ? v : fallback;
    };
    const picked = Array.prototype.slice.call(document.querySelectorAll('.botStratCb'))
      .filter(cb => cb.checked).map(cb => cb.value);
    s.config.strategies = picked.length ? picked : ['antiDivergence'];
    s.config.startingBankroll = num('botBankroll', s.config.startingBankroll);
    s.config.riskPerTradePct = num('botRisk', s.config.riskPerTradePct);
    s.config.minEdgePct = num('botMinEdge', s.config.minEdgePct);
    s.config.dailyLossLimitPct = num('botDailyLoss', s.config.dailyLossLimitPct);
    s.config.maxConsecutiveLosses = num('botMaxLosses', s.config.maxConsecutiveLosses);
    s.config.feeMultiplier = num('botFeeMult', s.config.feeMultiplier);
    saveBot(s);
    renderBot(loadBot());
  });

  const reset = document.getElementById('botReset');
  if (reset) reset.addEventListener('click', () => {
    if (!confirm('Reset the simulated account? All bot trades and balance will be cleared.')) return;
    const old = loadBot();
    const fresh = freshBotState();
    fresh.config = old.config;
    fresh.openPositions = [];
    fresh.bankroll = old.config.startingBankroll;
    fresh.peakBankroll = old.config.startingBankroll;
    fresh.dayStartBankroll = old.config.startingBankroll;
    saveBot(fresh);
    renderBot(loadBot());
  });
}

function wireBotToggle() {
  const toggle = document.getElementById('botToggle');
  if (!toggle) return;
  toggle.addEventListener('click', () => {
    const s = loadBot();
    s.config.enabled = !s.config.enabled;
    saveBot(s);
    updateBotToggle(s);
    renderBot(loadBot());
  });
  updateBotToggle(loadBot());
}

function updateBotToggle(s) {
  const toggle = document.getElementById('botToggle');
  if (!toggle) return;
  toggle.textContent = s.config.enabled ? 'Stop the bot' : 'Start the bot';
  toggle.className = s.config.enabled ? 'danger' : 'primary';
}

function renderCharts(market, strike) {
  // Odds chart for the current window
  drawLineChart('oddsChart', 'oddsChartEmpty',
    oddsHistory.map(p => ({ y: p.yesBid, t: p.t })),
    { color: '#4C8DF5', refLine: 50, refLabel: 'even', fixedMin: 0, fixedMax: 100,
      valueLabels: v => Math.round(v) + '%', timeLabels: true });

  // BTC price chart with the strike drawn in
  const hist = loadPriceHistory();
  drawLineChart('priceChart', 'priceChartEmpty',
    hist.map(p => ({ y: p.p, t: p.t })),
    { color: '#F7931A', refLine: strike ?? null, refColor: '#8B8F98',
      refLabel: strike != null ? 'strike' : null,
      fillTone: strike != null,
      valueLabels: v => '$' + Math.round(v).toLocaleString(),
      timeLabels: true });
}

function playAlertBeep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [0, 0.18, 0.36].forEach((delay, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.frequency.value = 880;
      gain.gain.setValueAtTime(0.15, ctx.currentTime + delay);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + delay + 0.15);
      osc.start(ctx.currentTime + delay);
      osc.stop(ctx.currentTime + delay + 0.15);
    });
  } catch (e) { /* audio not available, ignore */ }
}

function fmtPrice(p) {
  return '$' + p.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

async function fetchBTCPrice() {
  const sources = [
    { url: 'https://min-api.cryptocompare.com/data/price?fsym=BTC&tsyms=USD', parse: j => j.USD },
    { url: 'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd', parse: j => j.bitcoin.usd },
  ];
  for (const s of sources) {
    try {
      const res = await fetch(s.url);
      if (!res.ok) continue;
      const json = await res.json();
      const price = s.parse(json);
      if (typeof price === 'number' && price > 0) return price;
    } catch (e) { continue; }
  }
  return null;
}

async function fetchViaProxies(targetUrl) {
  const proxies = [
    'https://api.allorigins.win/raw?url=' + encodeURIComponent(targetUrl),
    'https://corsproxy.io/?url=' + encodeURIComponent(targetUrl)
  ];
  for (const proxied of proxies) {
    try {
      const res = await fetch(proxied);
      if (!res.ok) continue;
      const json = await res.json();
      if (json) return json;
    } catch (e) { continue; }
  }
  throw new Error('all proxies failed');
}

async function fetchKalshiWindow() {
  const target = 'https://external-api.kalshi.com/trade-api/v2/markets?series_ticker=KXBTC15M&status=open&limit=5';
  try {
    const json = await fetchViaProxies(target);
    if (!json.markets || json.markets.length === 0) return null;
    const sorted = json.markets.sort((a,b) => new Date(a.close_time) - new Date(b.close_time));
    return sorted[0];
  } catch (e) {
    window.lastKalshiError = e.message;
    return null;
  }
}

async function fetchSettledWindows() {
  const target = 'https://external-api.kalshi.com/trade-api/v2/markets?series_ticker=KXBTC15M&status=settled&limit=6';
  try {
    const json = await fetchViaProxies(target);
    return json.markets || [];
  } catch (e) {
    return [];
  }
}

function updateTimer() {
  if (!currentCloseTime) return;
  const now = new Date();
  const diff = currentCloseTime - now;
  const timerEl = document.getElementById('timer');
  const windowCard = document.getElementById('windowCard');
  if (diff <= 0) {
    timerEl.textContent = 'Settling…';
    timerEl.className = 'clock urgent';
    return;
  }
  const mins = Math.floor(diff / 60000);
  const secs = Math.floor((diff % 60000) / 1000);
  timerEl.textContent = mins + ':' + String(secs).padStart(2, '0');

  if (diff < 60000) {
    timerEl.className = 'clock urgent';
    windowCard.classList.add('final-minute');
    const windowKey = currentCloseTime.getTime();
    if (alertedForThisWindow !== windowKey) {
      alertedForThisWindow = windowKey;
      playAlertBeep();
    }
  } else {
    timerEl.className = 'clock';
    windowCard.classList.remove('final-minute');
  }
}

let lastBtcPrice = null;

async function loadAll() {
  const [market, btcPrice, settled] = await Promise.all([
    fetchKalshiWindow(),
    fetchBTCPrice(),
    fetchSettledWindows()
  ]);

  let yesAsk = null, noAsk = null;

  if (btcPrice) {
    const hist = recordPricePoint(btcPrice);
    window.currentMom1m = momentumOverWindow(hist, 60 * 1000);
    window.currentMom5m = momentumOverWindow(hist, 5 * 60 * 1000);
  }

  // Only fetch the 15m trend state once per new window, not every poll
  if (market && market.ticker !== currentTicker) {
    currentTicker = market.ticker;
    const trend = await fetchTrendState();
    window.currentTrendState = trend.state;
  }

  // Kalshi window card
  if (market) {
    currentCloseTime = new Date(market.close_time);
    if (countdownTimer) clearInterval(countdownTimer);
    updateTimer();
    countdownTimer = setInterval(updateTimer, 1000);

    const strike = market.floor_strike ?? market.cap_strike ?? null;
    document.getElementById('strikeInfo').innerHTML = strike
      ? 'Strike: <b>' + fmtPrice(strike) + '</b>'
      : (market.title || '');

    const yesBid = market.yes_bid ?? (market.yes_bid_dollars ? market.yes_bid_dollars * 100 : null);
    const noBid = market.no_bid ?? (market.no_bid_dollars ? market.no_bid_dollars * 100 : null);
    yesAsk = market.yes_ask ?? (market.yes_ask_dollars ? market.yes_ask_dollars * 100 : null);
    noAsk = market.no_ask ?? (market.no_ask_dollars ? market.no_ask_dollars * 100 : null);

    if (yesBid != null) {
      document.getElementById('upPct').textContent = yesBid + '%';
      document.getElementById('upPrice').textContent = 'at ' + yesBid + '¢';
    }
    if (noBid != null) {
      document.getElementById('downPct').textContent = noBid + '%';
      document.getElementById('downPrice').textContent = 'at ' + noBid + '¢';
    }
    document.getElementById('kalshiNote').textContent = market.title || '';
  } else {
    document.getElementById('strikeInfo').textContent = 'Unavailable';
    document.getElementById('kalshiNote').textContent = 'Error: ' + (window.lastKalshiError || 'could not reach Kalshi API');
  }

  // BTC price card
  if (btcPrice) {
    document.getElementById('btcPrice').textContent = fmtPrice(btcPrice);
    const deltaEl = document.getElementById('btcDelta');
    if (lastBtcPrice != null) {
      const diff = btcPrice - lastBtcPrice;
      const pct = (diff / lastBtcPrice) * 100;
      deltaEl.textContent = (diff >= 0 ? '+' : '') + pct.toFixed(3) + '% since last check';
      deltaEl.className = 'btc-delta ' + (diff > 0 ? 'up' : diff < 0 ? 'down' : 'flat');
    }
    lastBtcPrice = btcPrice;

    if (market && market.floor_strike) {
      const gap = btcPrice - market.floor_strike;
      const gapPct = (gap / market.floor_strike) * 100;
      document.getElementById('btcNote').textContent =
        (gap >= 0 ? gap.toFixed(0) + ' above' : Math.abs(gap).toFixed(0) + ' below') +
        ' this window\'s strike (' + (gapPct >= 0 ? '+' : '') + gapPct.toFixed(3) + '%)';

      // Divergence check: does spot's position vs strike disagree with the market's own lean?
      const banner = document.getElementById('divergenceBanner');
      const yesBid = market.yes_bid ?? (market.yes_bid_dollars ? market.yes_bid_dollars * 100 : null);
      let divergenceFiredNow = false;
      let divergenceDirectionNow = null;
      if (yesBid != null && Math.abs(gap) > 0) {
        const spotSaysUp = gap > 0;
        const marketSaysUp = yesBid > 50;
        const marketConfident = yesBid > 65 || yesBid < 35;
        if (spotSaysUp !== marketSaysUp && marketConfident) {
          divergenceFiredNow = true;
          divergenceDirectionNow = spotSaysUp ? 'up' : 'down';
          banner.className = 'notice show';
          banner.innerHTML = '<strong>Prices disagree.</strong> Bitcoin is trading ' +
            (spotSaysUp ? 'above' : 'below') + ' this window\'s strike, but the market is pricing ' +
            (marketSaysUp ? 'Up' : 'Down') + ' more likely (' + yesBid + '% up). Spot may have moved since the last quote, or the market expects reversion before close.';
        } else {
          banner.className = 'notice';
        }
      }

      recordObservation(market, btcPrice, divergenceFiredNow, divergenceDirectionNow,
        window.currentTrendState, window.currentMom1m, window.currentMom5m, yesBid, yesAsk, noAsk);

      window.lastDivergenceFired = divergenceFiredNow;
      window.lastDivergenceDirection = divergenceDirectionNow;

      const momDir = (typeof window.currentMom1m === 'number' && window.currentMom1m !== 0)
        ? (window.currentMom1m > 0 ? 'yes' : 'no') : null;

      // Aligned: strong 1-min momentum confirmed by 5-min pointing the same way
      const m1 = window.currentMom1m, m5 = window.currentMom5m;
      window.currentAlignedDir = (typeof m1 === 'number' && m1 !== 0 && Math.abs(m1) > 0.03 &&
                                  typeof m5 === 'number' && m5 !== 0 && (m5 > 0) === (m1 > 0))
        ? (m1 > 0 ? 'yes' : 'no') : null;

      const favDir = yesBid != null ? (yesBid > 50 ? 'yes' : 'no') : null;
      const agreeDir = (momDir != null && favDir != null && momDir === favDir) ? momDir : null;
      renderLiveSignals(momDir, favDir, agreeDir, divergenceFiredNow, divergenceDirectionNow);

      // Track odds over the life of this window; reset the history on a new window
      if (market.ticker !== currentChartTicker) {
        currentChartTicker = market.ticker;
        oddsHistory = [];
      }
      if (yesBid != null) {
        oddsHistory.push({ t: Date.now(), yesBid });
        if (oddsHistory.length > 300) oddsHistory.shift();
      }
      renderCharts(market, market.floor_strike ?? null);
    }

    const trendEl = document.getElementById('trendNote');
    const trendLabel = window.currentTrendState === 'bull' ? 'Bullish' : window.currentTrendState === 'bear' ? 'Bearish' : window.currentTrendState === 'neutral' ? 'Neutral' : '—';
    const mom1 = window.currentMom1m != null ? (window.currentMom1m >= 0 ? '+' : '') + window.currentMom1m.toFixed(3) + '%' : '—';
    trendEl.textContent = '15m trend: ' + trendLabel + ' · 1-min momentum: ' + mom1;
  } else {
    document.getElementById('btcPrice').textContent = 'Unavailable';
    document.getElementById('btcNote').textContent = 'Could not load BTC price.';
  }

  // Settled list
  const listEl = document.getElementById('settledList');
  if (settled.length === 0) {
    listEl.innerHTML = '<p class="quiet">No settled windows loaded yet.</p>';
  } else {
    listEl.innerHTML = '<div class="settled">' + settled.slice(0, 6).map(m => {
      const result = m.result === 'yes' ? 'Up' : m.result === 'no' ? 'Down' : m.result || '?';
      const dotClass = m.result === 'yes' ? 'yes' : 'no';
      const time = new Date(m.close_time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      return '<span class="chip"><span class="dot ' + dotClass + '"></span>' + result + '<span class="t">' + time + '</span></span>';
    }).join('') + '</div>';
  }

  reconcileSettled(settled);
  renderStats();
  renderPaperTrading();
  renderTradeFeed();

  // Feed the autonomous bot the same picture a live bot would act on.
  const settledResults = {};
  settled.forEach(m => { if (m.ticker && m.result) settledResults[m.ticker] = m.result; });
  // Include anything the log already knows is settled, so a position still
  // open in bot state gets closed out even if it left Kalshi's recent list.
  const fullLog = loadLog();
  Object.values(fullLog).forEach(r => {
    if (r.ticker && (r.result === 'yes' || r.result === 'no')) settledResults[r.ticker] = r.result;
  });

  const botState = botTick({
    market: market || null,
    ticker: market ? market.ticker : null,
    closeTime: market ? market.close_time : null,
    yesAsk, noAsk,
    yesBid: market ? (market.yes_bid ?? null) : null,
    mom1m: window.currentMom1m,
    mom5m: window.currentMom5m,
    divergenceFired: window.lastDivergenceFired || false,
    divergenceDirection: window.lastDivergenceDirection || null,
    settledResults
  });
  renderBot(botState);
  updateBotToggle(botState);

  document.getElementById('lastUpdate').textContent = 'Updated ' + new Date().toLocaleTimeString();
}

document.getElementById('refreshBtn').addEventListener('click', loadAll);
wireBotToggle();
renderBot(loadBot());
loadAll();
setInterval(loadAll, 15000);
</script>
