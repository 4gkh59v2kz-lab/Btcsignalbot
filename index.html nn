  );
  drawLineChart('equityChart', 'equityChartEmpty', curve, {
    color: m.returnPct >= 0 ? '#35C77E' : '#F05A63',
    refLine: startingBankroll,
    refColor: 'rgba(139,143,152,0.6)',
    refLabel: 'break even',
