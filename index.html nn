function confidenceBar(lo, hi, point, tone) {
  // Track spans 0-100%. Shows the plausible range as a band, the estimate as a marker,
  // and a coin-flip line at 50 so "is this better than chance" is visually obvious.
  const clamp = v => Math.max(0, Math.min(100, v));
  const l = clamp(lo), h = clamp(hi), p = clamp(point);
  const clears = l > 50;
  const fill = tone === 'muted' ? 'var(--dim)' : (clears ? 'var(--up)' : 'var(--warn)');
  return '<div class="ci-track">' +
    '<div class="ci-band" style="left:' + l + '%;width:' + Math.max(0.5, h - l) + '%;background:' + fill + '"></div>' +
    '<div class="ci-coinflip"></div>' +
    '<div class="ci-point" style="left:' + p + '%;background:' + fill + '"></div>' +
    '</div>';
}

