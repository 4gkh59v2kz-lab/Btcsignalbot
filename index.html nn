const PRICE_HISTORY_KEY = 'btc_price_history_v1';
function loadPriceHistory() {
  try {
    const raw = localStorage.getItem(PRICE_HISTORY_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch (e) { return []; }
}
function savePriceHistory(hist) {
  try { localStorage.setItem(PRICE_HISTORY_KEY, JSON.stringify(hist)); } catch (e) {}
}
function recordPricePoint(price) {
  const hist = loadPriceHistory();
  hist.push({ t: Date.now(), p: price });
  const cutoff = Date.now() - 10 * 60 * 1000; // keep 10 minutes
  const trimmed = hist.filter(pt => pt.t >= cutoff);
  savePriceHistory(trimmed);
  return trimmed;
}
function momentumOverWindow(hist, ms) {
  const now = Date.now();
  const target = now - ms;
  let closest = null;
  for (const pt of hist) {
    if (pt.t <= now && (closest === null || Math.abs(pt.t - target) < Math.abs(closest.t - target))) {
      closest = pt;
    }
  }
  if (!closest || hist.length === 0) return null;
  const latest = hist[hist.length - 1];
  if (!latest || closest.t === latest.t) return null;
  return ((latest.p - closest.p) / closest.p) * 100;
}

function ema(values, period) {
  const k = 2 / (period + 1);
  const out = new Array(values.length).fill(null);
  let prev = values.slice(0, period).reduce((a,b) => a+b, 0) / period;
  out[period - 1] = prev;
  for (let i = period; i < values.length; i++) {
    prev = values[i] * k + prev * (1 - k);
    out[i] = prev;
  }
  return out;
}
function rsi(values, period) {
  const out = new Array(values.length).fill(null);
  let gains = 0, losses = 0;
  for (let i = 1; i <= period; i++) {
    const diff = values[i] - values[i-1];
    if (diff >= 0) gains += diff; else losses -= diff;
  }
  let avgGain = gains / period, avgLoss = losses / period;
  out[period] = 100 - (100 / (1 + (avgLoss === 0 ? 100 : avgGain / avgLoss)));
  for (let i = period + 1; i < values.length; i++) {
    const diff = values[i] - values[i-1];
    const gain = diff > 0 ? diff : 0, loss = diff < 0 ? -diff : 0;
    avgGain = (avgGain * (period - 1) + gain) / period;
    avgLoss = (avgLoss * (period - 1) + loss) / period;
    const rs = avgLoss === 0 ? 100 : avgGain / avgLoss;
    out[i] = 100 - (100 / (1 + rs));
  }
  return out;
}

async function fetchTrendState() {
  // Primary: CryptoCompare 15m aggregated candles
  try {
    const url = 'https://min-api.cryptocompare.com/data/v2/histominute?fsym=BTC&tsym=USDT&limit=100&aggregate=15';
    const res = await fetch(url);
    if (res.ok) {
      const json = await res.json();
      if (json.Response === 'Success' && json.Data && Array.isArray(json.Data.Data)) {
        const closes = json.Data.Data.map(c => c.close).filter(c => c > 0);
        if (closes.length > 25) {
          const state = evalTrend(closes);
          if (state.state) return state;
        }
      }
    }
  } catch (e) { /* fall through to backup */ }

  // Backup: CoinGecko 30-min candles (coarser, but works when CryptoCompare is blocked)
  try {
    const url = 'https://api.coingecko.com/api/v3/coins/bitcoin/ohlc?vs_currency=usd&days=1';
    const res = await fetch(url);
    if (res.ok) {
      const arr = await res.json();
      if (Array.isArray(arr) && arr.length > 25) {
        const closes = arr.map(c => c[4]).filter(c => c > 0);
        return evalTrend(closes);
      }
    }
  } catch (e) { /* fall through */ }

  return { state: null, rsi: null };
}

function evalTrend(closes) {
  const e9 = ema(closes, 9), e21 = ema(closes, 21), r14 = rsi(closes, 14);
  const i = closes.length - 1;
  if (e9[i] != null && e21[i] != null && r14[i] != null) {
    if (e9[i] > e21[i] && r14[i] < 65) return { state: 'bull', rsi: r14[i] };
    if (e9[i] < e21[i] && r14[i] > 35) return { state: 'bear', rsi: r14[i] };
    return { state: 'neutral', rsi: r14[i] };
  }
  return { state: null, rsi: null };
}


// --- Live charts (plain canvas, no library) ---
let oddsHistory = []; // { t, yesBid } for the current window only
let currentChartTicker = null;

function drawLineChart(canvasId, emptyId, points, opts) {
  const canvas = document.getElementById(canvasId);
  const emptyEl = document.getElementById(emptyId);
  if (!canvas) return;

  if (!points || points.length < 2) {
    canvas.style.display = 'none';
    if (emptyEl) emptyEl.style.display = 'flex';
    return;
  }
  canvas.style.display = 'block';
  if (emptyEl) emptyEl.style.display = 'none';

  const dpr = window.devicePixelRatio || 1;
  const rect = canvas.parentElement.getBoundingClientRect();
  const w = Math.max(80, rect.width - 16);
  const h = Math.max(60, rect.height - 16);
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  canvas.style.width = w + 'px';
  canvas.style.height = h + 'px';

  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.clearRect(0, 0, w, h);

  // Leave room on the right for value labels, and at the bottom for time labels.
  const padR = opts.valueLabels ? 52 : 6;
  const padB = opts.timeLabels ? 16 : 4;
  const padT = 6;
  const plotW = w - padR - 3;
  const plotH = h - padB - padT;

  const ys = points.map(p => p.y);
  let min = Math.min(...ys), max = Math.max(...ys);
  if (opts.refLine != null) { min = Math.min(min, opts.refLine); max = Math.max(max, opts.refLine); }
  if (opts.fixedMin != null) min = opts.fixedMin;
  if (opts.fixedMax != null) max = opts.fixedMax;
  if (max - min < 1e-9) { max = min + 1; }
  // Only pad an auto-scaled axis. A fixed range (like 0-100% odds) must stay exact,
  // otherwise the labels drift into impossible values.
  if (opts.fixedMin == null && opts.fixedMax == null) {
    const pad = (max - min) * 0.12;
    min -= pad; max += pad;
  }

  const xAt = i => (i / (points.length - 1)) * plotW + 3;
  const yAt = v => padT + plotH - ((v - min) / (max - min)) * plotH;

  ctx.font = '10px ui-sans-serif, -apple-system, sans-serif';
  ctx.textBaseline = 'middle';

  // Horizontal gridlines with value labels on the right edge
  if (opts.valueLabels) {
    const ticks = 3;
    for (let i = 0; i <= ticks; i++) {
      const v = min + (max - min) * (i / ticks);
      const y = yAt(v);
      ctx.strokeStyle = 'rgba(255,255,255,0.045)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(3, y);
      ctx.lineTo(3 + plotW, y);
      ctx.stroke();
      ctx.fillStyle = '#7C8898';
      ctx.textAlign = 'left';
      ctx.fillText(opts.valueLabels(v), 3 + plotW + 6, y);
    }
  }

  // Reference line: the strike price, or the 50% coin-flip line
  if (opts.refLine != null) {
    const ry = yAt(opts.refLine);
    ctx.strokeStyle = opts.refColor || 'rgba(139,143,152,0.55)';
    ctx.setLineDash([4, 4]);
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(3, ry);
    ctx.lineTo(3 + plotW, ry);
    ctx.stroke();
    ctx.setLineDash([]);
    if (opts.refLabel) {
      ctx.fillStyle = opts.refColor || '#7C8898';
      ctx.textAlign = 'left';
      ctx.fillText(opts.refLabel, 6, Math.max(9, ry - 8));
    }
  }

  // Shade the area between the line and the reference, so "above/below strike" reads instantly
  if (opts.refLine != null && opts.fillTone) {
    const ry = yAt(opts.refLine);
    ctx.beginPath();
    ctx.moveTo(xAt(0), ry);
    points.forEach((p, i) => ctx.lineTo(xAt(i), yAt(p.y)));
    ctx.lineTo(xAt(points.length - 1), ry);
    ctx.closePath();
    const last = points[points.length - 1].y;
    ctx.fillStyle = last >= opts.refLine ? 'rgba(53,199,126,0.10)' : 'rgba(240,90,99,0.10)';
    ctx.fill();
  }

  // The line itself
  ctx.strokeStyle = opts.color || '#F7931A';
  ctx.lineWidth = 1.8;
  ctx.lineJoin = 'round';
  ctx.beginPath();
  points.forEach((p, i) => {
    const x = xAt(i), y = yAt(p.y);
    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  });
  ctx.stroke();

  // Latest point marker
  const lastX = xAt(points.length - 1), lastY = yAt(points[points.length - 1].y);
  ctx.fillStyle = opts.color || '#F7931A';
  ctx.beginPath();
  ctx.arc(lastX, lastY, 3, 0, Math.PI * 2);
  ctx.fill();

  // Time span labels along the bottom
  if (opts.timeLabels && points[0].t && points[points.length - 1].t) {
    const fmt = ts => new Date(ts).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    ctx.fillStyle = '#7C8898';
    ctx.textAlign = 'left';
    ctx.fillText(fmt(points[0].t), 3, h - 6);
    ctx.textAlign = 'right';
    ctx.fillText(fmt(points[points.length - 1].t), 3 + plotW, h - 6);
  }
}

// ============================================================
//  AUTONOMOUS BOT ENGINE
//  Simulates everything a live trading bot would do except
//  actually sending the order to Kalshi.
// ============================================================

const BOT_KEY = 'kxbtc15m_bot_v1';

const BOT_DEFAULTS = {
  startingBankroll: 100,
  riskPerTradePct: 2,        // % of bankroll staked per trade
  strategies: ['antiDivergence', 'alignedMomentum'],
  minEdgePct: 3,             // required edge over the market price, in points
  maxContracts: 500,
  dailyLossLimitPct: 10,     // stop trading for the day after this drawdown
  maxConsecutiveLosses: 5,   // cool off after this many losses in a row
  feeMultiplier: 0.07,       // Kalshi taker fee multiplier
  enabled: false
};

function loadBot() {
  try {
    const raw = localStorage.getItem(BOT_KEY);
    if (!raw) return freshBotState();
    const s = JSON.parse(raw);
    return Object.assign(freshBotState(), s);
  } catch (e) { return freshBotState(); }
}

function freshBotState() {
  return {
    config: Object.assign({}, BOT_DEFAULTS),
    bankroll: BOT_DEFAULTS.startingBankroll,
    peakBankroll: BOT_DEFAULTS.startingBankroll,
    openPositions: [],
    trades: [],
    consecutiveLosses: 0,
    dayKey: null,
    dayStartBankroll: BOT_DEFAULTS.startingBankroll,
    haltedReason: null
  };
}

function saveBot(s) {
  try { localStorage.setItem(BOT_KEY, JSON.stringify(s)); } catch (e) {}
}

// Kalshi taker fee: round up (0.07 x contracts x price x (1-price)) to the cent.
// Crypto markets may carry a higher multiplier, so it is configurable.
function kalshiFee(contracts, priceCents, multiplier) {
  const p = priceCents / 100;
  const raw = (multiplier || 0.07) * contracts * p * (1 - p);
  return Math.ceil(raw * 100) / 100;
}

// What the bot believes the true probability is, based on that strategy's
// measured hit rate. Uses the LOWER bound of the confidence interval, not the
// point estimate - betting the optimistic end of an uncertain range is how
// backtested edges turn into live losses.
function strategyEdge(strategyKey) {
  const paper = computePaperTrades();
  const stats = computeStats();
  let n = 0, wins = 0;
  if (strategyKey === 'antiDivergence') {
    n = stats.divergenceTotal; wins = stats.antiDivergenceCorrect;
  } else if (paper[strategyKey]) {
    n = paper[strategyKey].n; wins = paper[strategyKey].wins;
  }
  if (n < 20) return null; // not enough history to size a bet on
  const [lo] = wilsonInterval(wins, n);
  return { n, wins, point: (wins / n) * 100, conservative: lo };
}

// Which way, if any, does the configured strategy point this window?
function botSignal(cfg, ctx) {
  const { mom1m, mom5m, yesBid, divergenceFired, divergenceDirection } = ctx;
  switch (cfg.strategy) {
    case 'antiDivergence':
      if (!divergenceFired || !divergenceDirection) return null;
      return divergenceDirection === 'up' ? 'no' : 'yes';
    case 'alignedMomentum':
      if (typeof mom1m !== 'number' || mom1m === 0 || Math.abs(mom1m) <= 0.03) return null;
      if (typeof mom5m !== 'number' || mom5m === 0) return null;
      if ((mom5m > 0) !== (mom1m > 0)) return null;
      return mom1m > 0 ? 'yes' : 'no';
    case 'filteredMomentum':
      if (typeof mom1m !== 'number' || Math.abs(mom1m) <= 0.03) return null;
      return mom1m > 0 ? 'yes' : 'no';
    case 'agreement':
      if (typeof mom1m !== 'number' || mom1m === 0 || yesBid == null) return null;
      if ((mom1m > 0) !== (yesBid > 50)) return null;
      return mom1m > 0 ? 'yes' : 'no';
    case 'favorite':
      if (yesBid == null) return null;
      return yesBid > 50 ? 'yes' : 'no';
    default:
      return null;
  }
}

// Risk gate. Returns a reason string if the bot should NOT trade.
function botRiskCheck(s, entryCents, contracts, strategyKey) {
  const cfg = s.config;
  if (!cfg.enabled) return 'Bot is switched off';
  if (s.bankroll < 2) return 'Bankroll too low to trade';

  const dayLoss = ((s.dayStartBankroll - s.bankroll) / s.dayStartBankroll) * 100;
  if (dayLoss >= cfg.dailyLossLimitPct) return 'Daily loss limit hit (' + dayLoss.toFixed(1) + '%)';
  if (s.consecutiveLosses >= cfg.maxConsecutiveLosses) {
    return 'Cooling off after ' + s.consecutiveLosses + ' losses in a row';
  }
  if (contracts < 1) return 'Stake too small for even one contract';
  if (entryCents >= 97 || entryCents <= 3) return 'Contract price outside sane range';
  return null;
}

const STRATEGY_LABELS = {
  antiDivergence: 'Anti-divergence',
  alignedMomentum: 'Aligned momentum',
  filteredMomentum: 'Filtered momentum',
  agreement: 'Agreement',
  favorite: 'Favorite'
};

// Main bot tick. Runs every refresh, for every enabled strategy independently.
function botTick(ctx) {
  const s = loadBot();
  const cfg = s.config;
  if (!Array.isArray(s.openPositions)) s.openPositions = [];
  if (!Array.isArray(cfg.strategies)) cfg.strategies = [cfg.strategy || 'antiDivergence'];

  // Roll the daily counters at midnight local time
  const todayKey = new Date().toDateString();
  if (s.dayKey !== todayKey) {
    s.dayKey = todayKey;
    s.dayStartBankroll = s.bankroll;
    s.consecutiveLosses = 0;
  }

  // 1. Settle any positions whose window has closed
  if (ctx.settledResults) {
    const still = [];
    s.openPositions.forEach(pos => {
      const res = ctx.settledResults[pos.ticker];
      if (res !== 'yes' && res !== 'no') { still.push(pos); return; }
      const won = pos.side === res;
      const payout = won ? pos.contracts * 1.00 : 0;
      s.bankroll += payout;
      s.trades.unshift({
        ticker: pos.ticker, strategy: pos.strategy, side: pos.side,
        contracts: pos.contracts, entryCents: pos.entryCents, fee: pos.fee,
        totalCost: pos.totalCost, payout, net: payout - pos.totalCost, won,
        openedAt: pos.openedAt, closedAt: Date.now(), bankrollAfter: s.bankroll
      });
      s.consecutiveLosses = won ? 0 : s.consecutiveLosses + 1;
      s.peakBankroll = Math.max(s.peakBankroll, s.bankroll);
    });
    if (s.trades.length > 500) s.trades.length = 500;
    s.openPositions = still;
  }

  // 2. Consider a position for each enabled strategy, independently
  const reasons = [];
  if (ctx.market && ctx.ticker) {
    cfg.strategies.forEach(key => {
      const label = STRATEGY_LABELS[key] || key;
      if (s.openPositions.some(p => p.ticker === ctx.ticker && p.strategy === key)) {
        reasons.push(label + ': already in this window');
        return;
      }
      const side = botSignal({ strategy: key }, ctx);
      if (!side) { reasons.push(label + ': no signal'); return; }

      const entryCents = side === 'yes' ? ctx.yesAsk : ctx.noAsk;
      if (entryCents == null) { reasons.push(label + ': no price'); return; }

      const edge = strategyEdge(key);
      if (!edge) { reasons.push(label + ': needs 20+ logged trades first'); return; }

      const edgePts = edge.conservative - entryCents;
      if (edgePts < cfg.minEdgePct) {
        reasons.push(label + ': edge only ' + edgePts.toFixed(1) + ' pts');
        return;
      }

      const stake = s.bankroll * (cfg.riskPerTradePct / 100);
      let contracts = Math.floor(stake / (entryCents / 100));
      contracts = Math.min(contracts, cfg.maxContracts);
      const fee = kalshiFee(contracts, entryCents, cfg.feeMultiplier);
      const totalCost = contracts * (entryCents / 100) + fee;

      const blocked = botRiskCheck(s, entryCents, contracts, key);
      if (blocked) { reasons.push(label + ': ' + blocked); return; }
      if (totalCost > s.bankroll) { reasons.push(label + ': not enough cash'); return; }

      s.bankroll -= totalCost;
      s.openPositions.push({
        ticker: ctx.ticker, strategy: key, side, contracts, entryCents,
        fee, totalCost, edgePts, openedAt: Date.now(), closeTime: ctx.closeTime
      });
      reasons.push(label + ': entered ' + contracts + ' × ' + (side === 'yes' ? 'Up' : 'Down'));
    });
  }
  s.lastReasons = reasons;

  saveBot(s);
  return s;
}

function botMetrics(s) {
  const t = s.trades;
  const n = t.length;
  const wins = t.filter(x => x.won).length;
  const grossPnl = t.reduce((a, x) => a + x.net, 0);
  const totalFees = t.reduce((a, x) => a + x.fee, 0);
  const startingBankroll = s.config.startingBankroll;
  const held = (s.openPositions || []).reduce((a, p) => a + p.totalCost, 0);
  const equity = s.bankroll + held;
  const returnPct = ((equity - startingBankroll) / startingBankroll) * 100;

  // Max drawdown across the recorded equity path
  let peak = startingBankroll, maxDD = 0;
  const path = [...t].reverse();
  path.forEach(x => {
    peak = Math.max(peak, x.bankrollAfter);
    const dd = ((peak - x.bankrollAfter) / peak) * 100;
    maxDD = Math.max(maxDD, dd);
  });

  return {
    n, wins,
    winPct: n ? (wins / n) * 100 : 0,
    grossPnl, totalFees,
    netPerTrade: n ? (grossPnl / n) * 100 : 0,
    equity, returnPct, maxDD,
    peak: s.peakBankroll,
    openCount: (s.openPositions || []).length,
    held
  };
}

