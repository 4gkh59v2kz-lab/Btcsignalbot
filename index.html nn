<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BTC 15-minute windows</title>
<style>
  :root {
    --ink: #0B0F14;
    --panel: #131A23;
    --panel-2: #0F151C;
    --line: #202A36;
    --text: #E8EBEF;
    --dim: #7C8898;
    --up: #35C77E;
    --down: #F05A63;
    --warn: #E0A340;
    --accent: #F7931A;
    --radius: 14px;
  }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--text);
    font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    padding: 24px 18px 64px;
  }
  .page { max-width: 940px; margin: 0 auto; }

  .masthead {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 20px; flex-wrap: wrap; margin-bottom: 28px;
  }
  .masthead h1 {
    font-size: 26px; line-height: 1.15; font-weight: 650;
    letter-spacing: -0.02em; margin: 0 0 4px;
  }
  .masthead p { margin: 0; color: var(--dim); font-size: 15px; max-width: 46ch; }
  .refresh-line { display: flex; align-items: center; gap: 12px; }

  button {
    font: inherit; font-size: 14px; font-weight: 500;
    color: var(--text); background: var(--panel);
    border: 1px solid var(--line); border-radius: 10px;
    padding: 9px 15px; cursor: pointer;
  }
  button:hover { border-color: #2E3B4A; }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .stamp { font-size: 13px; color: var(--dim); font-variant-numeric: tabular-nums; }

  /* ---- Window bar: the live countdown, price, strike ---- */
  .window-bar {
    display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center;
    background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 20px 24px; margin-bottom: 22px;
    transition: border-color .3s, box-shadow .3s;
  }
  .window-bar.final-minute {
    border-color: var(--down);
    box-shadow: 0 0 0 1px rgba(240,90,99,.35), 0 0 28px rgba(240,90,99,.14);
  }
  .clock {
    font-variant-numeric: tabular-nums; font-size: 46px; font-weight: 600;
    letter-spacing: -0.03em; line-height: 1;
  }
  .clock.urgent { color: var(--down); }
  .clock-l { font-size: 13px; color: var(--dim); margin-top: 6px; }
  .odds-pair { display: flex; gap: 10px; justify-content: center; }
  .odds {
    flex: 1; max-width: 190px; text-align: center;
    border: 1px solid var(--line); border-radius: 11px; padding: 12px 8px;
  }
  .odds.up { background: rgba(53,199,126,.08); border-color: rgba(53,199,126,.28); }
  .odds.down { background: rgba(240,90,99,.08); border-color: rgba(240,90,99,.28); }
  .odds-v { font-variant-numeric: tabular-nums; font-size: 30px; font-weight: 650; line-height: 1.1; }
  .odds.up .odds-v { color: var(--up); }
  .odds.down .odds-v { color: var(--down); }
  .odds-l { font-size: 13px; color: var(--dim); }
  .price-side { text-align: right; }
  .price-v { font-variant-numeric: tabular-nums; font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
  .price-l { font-size: 13px; color: var(--dim); margin-top: 4px; }
  .price-l .pos { color: var(--up); }
  .price-l .neg { color: var(--down); }

  /* ---- Sections ---- */
  section { margin-bottom: 30px; }
  section > h2 {
    font-size: 15px; font-weight: 600; letter-spacing: -0.01em;
    margin: 0 0 4px; color: var(--text);
  }
  section > .lede { margin: 0 0 14px; font-size: 14px; color: var(--dim); max-width: 62ch; }
  .panel {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 20px 22px;
  }

  /* ---- Live signal cards (the hero) ---- */
  .calls { display: grid; grid-template-columns: repeat(auto-fit, minmax(208px, 1fr)); gap: 12px; }
  .call {
    background: var(--panel-2); border: 1px solid var(--line);
    border-radius: 12px; padding: 16px 17px;
  }
  .call h3 { font-size: 14px; font-weight: 550; margin: 0 0 10px; color: var(--dim); }
  .call.up { border-left: 3px solid var(--up); }
  .call.down { border-left: 3px solid var(--down); }
  .call.idle { opacity: .62; }
  .call-dir { font-size: 32px; font-weight: 650; letter-spacing: -0.02em; margin: 0 0 2px; line-height: 1.05; }
  .call.up .call-dir { color: var(--up); }
  .call.down .call-dir { color: var(--down); }
  .call-idle { font-size: 20px; font-weight: 500; color: var(--dim); margin: 0 0 4px; }
  .call-rate { font-size: 14px; margin: 0 0 8px; font-variant-numeric: tabular-nums; }

  /* ---- Confidence interval bar ---- */
  .ci-track {
    position: relative; height: 7px; border-radius: 4px;
    background: #1B2531; overflow: hidden; margin: 4px 0 5px;
  }
  .ci-band { position: absolute; top: 0; bottom: 0; opacity: .42; border-radius: 4px; }
  .ci-coinflip { position: absolute; left: 50%; top: -1px; bottom: -1px; width: 1px; background: #3C4A5B; }
  .ci-point { position: absolute; top: -1px; width: 3px; height: 9px; border-radius: 2px; transform: translateX(-1.5px); }
  .ci-cell { min-width: 148px; }

  /* ---- Tables ---- */
  table.lead { width: 100%; border-collapse: collapse; }
  table.lead th {
    text-align: left; font-size: 13px; font-weight: 550; color: var(--dim);
    padding: 0 12px 9px 0; border-bottom: 1px solid var(--line);
  }
  table.lead th.num, table.lead td.num { text-align: right; font-variant-numeric: tabular-nums; }
  table.lead td { padding: 13px 12px 13px 0; border-bottom: 1px solid #1A222C; vertical-align: middle; }
  table.lead tr:last-child td { border-bottom: none; }
  table.lead tr.top td { background: rgba(247,147,26,.045); }
  .s-name { display: block; font-size: 15px; font-weight: 500; }
  .s-note { display: block; font-size: 12.5px; color: var(--dim); margin-top: 2px; }
  td.big { font-size: 21px; font-weight: 600; letter-spacing: -0.01em; }
  td.big.pos { color: var(--up); }
  td.big.neg { color: var(--down); }
  .quiet-cell { color: var(--dim); font-size: 13.5px; }
  .quiet { color: var(--dim); font-size: 13.5px; margin: 14px 0 0; max-width: 68ch; }

  /* ---- Tally strip ---- */
  .tally { display: flex; gap: 30px; flex-wrap: wrap; margin-bottom: 18px; }
  .tally-n { display: block; font-size: 25px; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .tally-l { display: block; font-size: 13px; color: var(--dim); margin-top: 1px; }

  /* ---- Charts ---- */
  .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .chart-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
  .chart-card h3 { font-size: 14px; font-weight: 550; margin: 0 0 2px; }
  .chart-card p.cap { font-size: 12.5px; color: var(--dim); margin: 0 0 10px; }
  .chart-box { position: relative; height: 132px; }
  .chart-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--dim); font-size: 13px; }

  /* ---- Settled list ---- */
  .settled { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: flex; align-items: center; gap: 7px;
    background: var(--panel-2); border: 1px solid var(--line);
    border-radius: 9px; padding: 8px 12px; font-size: 13.5px;
    font-variant-numeric: tabular-nums;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .dot.yes { background: var(--up); }
  .dot.no { background: var(--down); }
  .chip .t { color: var(--dim); font-size: 12.5px; }

  /* ---- Divergence notice ---- */
  .notice {
    display: none; background: rgba(224,163,64,.09); border: 1px solid rgba(224,163,64,.32);
    border-radius: 12px; padding: 14px 17px; font-size: 14px; color: #EBD3A8;
    margin-bottom: 22px; line-height: 1.5;
  }
  .notice.show { display: block; }
  .notice strong { color: var(--warn); font-weight: 600; }

  /* ---- Data row ---- */
  .data-row { display: flex; gap: 10px; flex-wrap: wrap; }

  /* ---- Autonomous bot ---- */
  .sec-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; flex-wrap: wrap; }
  button.primary { background: var(--accent); border-color: var(--accent); color: #1A1206; font-weight: 600; }
  button.danger { background: rgba(240,90,99,.14); border-color: rgba(240,90,99,.5); color: var(--down); font-weight: 600; }

  .bot-top { display: flex; justify-content: space-between; gap: 26px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 18px; }
  .be-v { display: block; font-size: 38px; font-weight: 650; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1.05; }
  .be-v.pos { color: var(--up); }
  .be-v.neg { color: var(--down); }
  .be-l { display: block; font-size: 13px; color: var(--dim); margin-top: 4px; }
  .bot-kpis { display: flex; gap: 22px; flex-wrap: wrap; }
  .k-v { display: block; font-size: 19px; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
  .k-v.pos { color: var(--up); }
  .k-v.neg { color: var(--down); }
  .k-l { display: block; font-size: 12.5px; color: var(--dim); margin-top: 1px; }

  .bot-now { border-radius: 11px; padding: 14px 16px; margin-bottom: 16px; border: 1px solid var(--line); background: var(--panel-2); }
  .bot-now.live { border-color: rgba(247,147,26,.45); background: rgba(247,147,26,.07); }
  .bot-now.waiting { border-style: dashed; }
  .bot-now.off { opacity: .7; }
  .bn-head { margin: 0 0 3px; font-size: 16px; font-weight: 550; }
  .bn-sub { margin: 8px 0 0; font-size: 12.5px; color: var(--dim); line-height: 1.5; }
  .bn-pos { margin: 7px 0 0; font-size: 14px; }
  .bp-strat { font-weight: 550; }
  .bp-meta { color: var(--dim); font-size: 12.5px; }
  .bs-strats { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 7px; font-size: 13px; color: var(--dim); }
  .bs-checks { display: flex; flex-wrap: wrap; gap: 8px; }
  .bs-check { display: flex; align-items: center; gap: 6px; font-size: 13.5px; color: var(--text);
    background: var(--panel-2); border: 1px solid var(--line); border-radius: 8px; padding: 7px 11px; cursor: pointer; }
  .bs-check input { accent-color: var(--accent); }
  .b-strat { color: var(--dim); }

  .bot-chart { position: relative; height: 150px; margin-bottom: 18px; }

  .bot-settings { border-top: 1px solid var(--line); padding-top: 14px; margin-bottom: 6px; }
  .bot-settings summary { cursor: pointer; font-size: 14px; color: var(--dim); font-weight: 500; }
  .bot-settings summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .bs-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 14px 0; }
  .bs-field { display: flex; flex-direction: column; gap: 5px; font-size: 13px; color: var(--dim); }
  .bs-field input, .bs-field select {
    font: inherit; font-size: 14px; color: var(--text);
    background: var(--panel-2); border: 1px solid var(--line);
    border-radius: 8px; padding: 8px 10px; width: 100%;
  }
  .bs-field input:focus-visible, .bs-field select:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .bs-actions { display: flex; gap: 9px; flex-wrap: wrap; }

  .bot-h3 { font-size: 14px; font-weight: 550; margin: 20px 0 8px; }
  ul.blotter { list-style: none; margin: 0; padding: 0; }
  ul.blotter li {
    display: grid; grid-template-columns: 18px 1fr auto 72px 72px 58px;
    gap: 10px; align-items: baseline; font-size: 14px;
    padding: 9px 0; border-bottom: 1px solid #1A222C;
  }
  ul.blotter li:last-child { border-bottom: none; }
  .b-mark { font-size: 13px; }
  li.won .b-mark { color: var(--up); }
  li.lost .b-mark { color: var(--down); }
  .b-desc { font-variant-numeric: tabular-nums; }
  .b-fee, .b-bank, .b-time { color: var(--dim); font-size: 12.5px; font-variant-numeric: tabular-nums; text-align: right; }
  .b-net { text-align: right; font-weight: 550; font-variant-numeric: tabular-nums; }
  .b-net.pos { color: var(--up); }
  .b-net.neg { color: var(--down); }
  @media (max-width: 700px) {
    ul.blotter li { grid-template-columns: 18px 1fr 74px; row-gap: 2px; }
    .b-fee, .b-bank { grid-column: 2; text-align: left; }
    .b-time { grid-column: 3; }
    .be-v { font-size: 32px; }
  }

  /* ---- Trade feed ---- */
  .feed-sum { margin: 0 0 12px; font-size: 14px; color: var(--dim); }
  .feed-sum strong { font-variant-numeric: tabular-nums; font-size: 17px; }
  .feed-sum strong.pos { color: var(--up); }
  .feed-sum strong.neg { color: var(--down); }
  ul.feed { list-style: none; margin: 0; padding: 0; }
  ul.feed li {
    display: grid;
    grid-template-columns: 18px 1fr auto 56px 58px;
    gap: 10px; align-items: baseline;
    padding: 9px 0; border-bottom: 1px solid #1A222C;
    font-size: 14px;
  }
  ul.feed li:last-child { border-bottom: none; }
  .f-mark { font-size: 13px; }
  li.won .f-mark { color: var(--up); }
  li.lost .f-mark { color: var(--down); }
  .f-strat { font-weight: 500; }
  .f-side { color: var(--dim); font-size: 13px; font-variant-numeric: tabular-nums; }
  .f-pnl { text-align: right; font-variant-numeric: tabular-nums; font-weight: 550; }
  .f-pnl.pos { color: var(--up); }
  .f-pnl.neg { color: var(--down); }
  .f-time { text-align: right; color: var(--dim); font-size: 12.5px; font-variant-numeric: tabular-nums; }
  @media (max-width: 620px) {
    ul.feed li { grid-template-columns: 18px 1fr 52px; row-gap: 2px; }
    .f-side { grid-column: 2; font-size: 12.5px; }
    .f-time { grid-column: 3; }
  }

  .fine {
    margin-top: 34px; padding: 16px 18px;
    border: 1px solid rgba(240,90,99,.22); background: rgba(240,90,99,.05);
    border-radius: 12px; font-size: 13px; color: #C4CBD4; line-height: 1.55; max-width: 76ch;
  }
  .fine strong { color: var(--down); font-weight: 600; }

  @media (max-width: 760px) {
    body { padding: 18px 14px 48px; }
    .window-bar { grid-template-columns: 1fr; gap: 18px; text-align: center; }
    .price-side { text-align: center; }
    .chart-grid { grid-template-columns: 1fr; }
    .clock { font-size: 40px; }
  }
</style>
</head>
<body>
<div class="page">

  <header class="masthead">
    <div>
      <h1>Bitcoin 15-minute windows</h1>
      <p>Live Kalshi odds, tested signals, and an honest read on how much any of it can be trusted.</p>
    </div>
    <div class="refresh-line">
      <button id="refreshBtn">Refresh</button>
      <span class="stamp" id="lastUpdate"></span>
    </div>
  </header>

  <div class="window-bar" id="windowCard">
    <div>
      <div class="clock" id="timer">--:--</div>
      <div class="clock-l" id="strikeInfo">Loading</div>
    </div>
    <div class="odds-pair">
      <div class="odds up">
        <div class="odds-v" id="upPct">—</div>
        <div class="odds-l">Up <span id="upPrice"></span></div>
      </div>
      <div class="odds down">
        <div class="odds-v" id="downPct">—</div>
        <div class="odds-l">Down <span id="downPrice"></span></div>
      </div>
    </div>
    <div class="price-side">
      <div class="price-v" id="btcPrice">—</div>
      <div class="price-l" id="btcNote"></div>
      <div class="price-l" id="trendNote"></div>
      <div class="price-l" id="btcDelta"></div>
      <div class="price-l" id="kalshiNote" style="display:none"></div>
    </div>
  </div>

  <div class="notice" id="divergenceBanner"></div>

  <section>
    <h2>What the signals say right now</h2>
    <p class="lede">Each signal either points a direction this window or sits out. The bar underneath shows the range its true accuracy plausibly falls in — a bar crossing the centre line has not beaten chance.</p>
    <div class="panel" id="liveSignalsCard">
      <div id="liveSignalsBody"><p class="quiet">Loading</p></div>
    </div>
  </section>

  <section>
    <div class="chart-grid">
      <div class="chart-card">
        <h3>Market odds this window</h3>
        <p class="cap">Chance of finishing up, since the window opened</p>
        <div class="chart-box">
          <canvas id="oddsChart" role="img" aria-label="Kalshi up odds over the life of this window"></canvas>
          <div class="chart-empty" id="oddsChartEmpty">Builds as the window runs</div>
        </div>
      </div>
      <div class="chart-card">
        <h3>Bitcoin price</h3>
        <p class="cap">Recent minutes, with this window's strike marked</p>
        <div class="chart-box">
          <canvas id="priceChart" role="img" aria-label="Bitcoin price over recent minutes with the strike price marked"></canvas>
          <div class="chart-empty" id="priceChartEmpty">Builds as data arrives</div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2>Simulated trading</h2>
    <p class="lede">What each strategy would have earned per contract at real entry prices. No money is at stake.</p>
    <div class="panel" id="paperTradingCard">
      <div id="paperTradingBody"><p class="quiet">Loading</p></div>
    </div>
  </section>

  <section>
    <div class="sec-head">
      <div>
        <h2>Autonomous bot</h2>
        <p class="lede">Runs the full decision loop a live bot would: sizes positions against your bankroll, checks the edge is worth the price, pays Kalshi's real fees, and stops itself when losses stack up. Nothing is sent to Kalshi.</p>
      </div>
      <button id="botToggle" class="primary">Start the bot</button>
    </div>
    <div class="panel">
      <div id="botBody"><p class="quiet">Loading</p></div>
    </div>
  </section>

  <section>
    <h2>Trades as they settle</h2>
    <p class="lede">Every simulated position the tested strategies took, newest first, with what it would have paid.</p>
    <div class="panel">
      <div id="tradeFeedBody"><p class="quiet">Loading</p></div>
    </div>
  </section>

  <section>
    <h2>Signal accuracy</h2>
    <p class="lede">How often each signal has called the direction correctly across every window logged.</p>
    <div class="panel">
      <div id="statsBody"><p class="quiet">Loading</p></div>
    </div>
  </section>

  <section>
    <h2>Recently settled</h2>
    <div class="panel">
      <div id="settledList"><p class="quiet">Loading</p></div>
    </div>
  </section>

  <section>
    <h2>Your data</h2>
    <p class="lede">Everything is stored in this browser only. Clearing site data erases it, so export regularly and import to restore.</p>
    <div class="panel">
      <div class="data-row">
        <button id="exportBtn">Export data</button>
        <button id="importBtn">Import data</button>
        <button id="clearLogBtn">Clear log</button>
        <input type="file" id="importFile" accept="application/json,.json" style="display:none">
      </div>
    </div>
  </section>

  <p class="fine">
    <strong>Not financial advice.</strong> Nothing here predicts the future. The percentages are the market's own pricing and this tool's historical hit rate, both of which carry real uncertainty. Simulated profit excludes Kalshi's trading fees, so live results would run lower.
  </p>

</div>
<script>
const LOG_KEY = 'kxbtc15m_log_v1';
const MAX_LOG_SIZE = 1000;

function loadLog() {
  try {
    const raw = localStorage.getItem(LOG_KEY);
    return raw ? JSON.parse(raw) : {};
  } catch (e) { return {}; }
}

function saveLog(log) {
  try {
    localStorage.setItem(LOG_KEY, JSON.stringify(log));
  } catch (e) { /* storage full or unavailable, ignore */ }
}

function pruneLog(log) {
  const keys = Object.keys(log);
  if (keys.length <= MAX_LOG_SIZE) return log;
  const sorted = keys.sort((a, b) => new Date(log[a].closeTime) - new Date(log[b].closeTime));
  const toRemove = sorted.slice(0, keys.length - MAX_LOG_SIZE);
  toRemove.forEach(k => delete log[k]);
  return log;
}

function recordObservation(market, btcPrice, divergenceFired, divergenceDirection, trendState, mom1m, mom5m, resolvedYesBid, resolvedYesAsk, resolvedNoAsk) {
  const log = loadLog();
  const ticker = market.ticker;
  if (!ticker) return;

  if (!log[ticker]) {
    log[ticker] = {
      ticker,
      closeTime: market.close_time,
      strike: market.floor_strike ?? null,
      firstYesBid: resolvedYesBid ?? null,
      firstYesAsk: resolvedYesAsk ?? null,
      firstNoAsk: resolvedNoAsk ?? null,
      firstBtcPrice: btcPrice,
      firstTrendState: trendState ?? null,
      firstMom1m: mom1m ?? null,
      firstMom5m: mom5m ?? null,
      hourUTC: new Date().getUTCHours(),
      dayOfWeekUTC: new Date().getUTCDay(),
      midYesBid: null,
      midBtcPrice: null,
      midCaptured: false,
      lastYesBid: resolvedYesBid ?? null,
      lastBtcPrice: btcPrice,
      divergenceSeen: false,
      divergenceDirection: null,
      result: null,
      source: 'observed'
    };
  }
  const rec = log[ticker];
  rec.lastYesBid = resolvedYesBid ?? rec.lastYesBid;
  rec.lastBtcPrice = btcPrice ?? rec.lastBtcPrice;

  // Capture a mid-window snapshot once we're roughly 40-60% through
  if (!rec.midCaptured && currentCloseTime) {
    const remaining = currentCloseTime - new Date();
    const fractionElapsed = 1 - (remaining / 900000);
    if (fractionElapsed >= 0.4 && fractionElapsed <= 0.65) {
      rec.midYesBid = resolvedYesBid ?? null;
      rec.midBtcPrice = btcPrice;
      rec.midCaptured = true;
    }
  }

  if (divergenceFired && !rec.divergenceSeen) {
    rec.divergenceSeen = true;
    rec.divergenceDirection = divergenceDirection;
  }
  saveLog(pruneLog(log));
}

function reconcileSettled(settledMarkets) {
  const log = loadLog();
  let changed = false;
  settledMarkets.forEach(m => {
    if (!m.ticker) return;
    if (!log[m.ticker]) {
      // We never observed this window live - backfill minimal record
      log[m.ticker] = {
        ticker: m.ticker,
        closeTime: m.close_time,
        strike: m.floor_strike ?? null,
        firstYesBid: null,
        firstBtcPrice: null,
        firstTrendState: null,
        firstMom1m: null,
        firstMom5m: null,
        midYesBid: null,
        midBtcPrice: null,
        midCaptured: false,
        lastYesBid: null,
        lastBtcPrice: null,
        divergenceSeen: false,
        divergenceDirection: null,
        result: m.result ?? null,
        source: 'backfill'
      };
      changed = true;
    } else if (log[m.ticker].result == null && m.result) {
      log[m.ticker].result = m.result;
      changed = true;
    }
  });
  if (changed) saveLog(pruneLog(log));
}

function computeStats() {
  const log = loadLog();
  const records = Object.values(log).filter(r => r.result === 'yes' || r.result === 'no');

  const total = records.length;
  const upCount = records.filter(r => r.result === 'yes').length;
  const downCount = total - upCount;
  const observedCount = records.filter(r => r.source === 'observed').length;
  const backfillCount = total - observedCount;

  const observedWithFirstBid = records.filter(r => r.firstYesBid != null);
  const favoriteWins = observedWithFirstBid.filter(r => {
    const favoredUp = r.firstYesBid > 50;
    return (favoredUp && r.result === 'yes') || (!favoredUp && r.result === 'no');
  }).length;

  const divergenceRecords = records.filter(r => r.divergenceSeen && r.divergenceDirection);
  const divergenceCorrect = divergenceRecords.filter(r =>
    (r.divergenceDirection === 'up' && r.result === 'yes') ||
    (r.divergenceDirection === 'down' && r.result === 'no')
  ).length;
  const antiDivergenceCorrect = divergenceRecords.length - divergenceCorrect;

  const trendRecords = records.filter(r => r.firstTrendState === 'bull' || r.firstTrendState === 'bear');
  const trendCorrect = trendRecords.filter(r =>
    (r.firstTrendState === 'bull' && r.result === 'yes') ||
    (r.firstTrendState === 'bear' && r.result === 'no')
  ).length;

  const momRecords = records.filter(r => typeof r.firstMom1m === 'number' && r.firstMom1m !== 0);
  const momCorrect = momRecords.filter(r =>
    (r.firstMom1m > 0 && r.result === 'yes') ||
    (r.firstMom1m < 0 && r.result === 'no')
  ).length;

  return {
    total, upCount, downCount, observedCount, backfillCount,
    observedWithFirstBid: observedWithFirstBid.length, favoriteWins,
    divergenceTotal: divergenceRecords.length, divergenceCorrect, antiDivergenceCorrect,
    trendTotal: trendRecords.length, trendCorrect,
    momTotal: momRecords.length, momCorrect
  };
}

function computePaperTrades() {
  const log = loadLog();
  const records = Object.values(log).filter(r => r.result === 'yes' || r.result === 'no');

  const strategies = {
    momentum: { n: 0, wins: 0, totalPnl: 0 },
    filteredMomentum: { n: 0, wins: 0, totalPnl: 0 },
    alignedMomentum: { n: 0, wins: 0, totalPnl: 0 },
    favorite: { n: 0, wins: 0, totalPnl: 0 },
    agreement: { n: 0, wins: 0, totalPnl: 0 },
    antiDivergence: { n: 0, wins: 0, totalPnl: 0 }
  };

  for (const r of records) {
    const hasMom = typeof r.firstMom1m === 'number' && r.firstMom1m !== 0;
    const hasBid = r.firstYesBid != null;

    // Strategy 1: momentum direction
    if (hasMom) {
      const side = r.firstMom1m > 0 ? 'yes' : 'no';
      const entry = side === 'yes' ? r.firstYesAsk : r.firstNoAsk;
      if (entry != null) {
        const won = (side === 'yes' && r.result === 'yes') || (side === 'no' && r.result === 'no');
        const cost = entry / 100;
        const pnl = won ? (1 - cost) : -cost;
        strategies.momentum.n++;
        if (won) strategies.momentum.wins++;
        strategies.momentum.totalPnl += pnl;

        // Filtered variant: only take it when momentum is strong, not near-zero noise.
        // Threshold fixed at 0.03% based on backtested magnitude buckets - not recalculated
        // live, so this rule doesn't drift or look ahead as more data comes in.
        if (Math.abs(r.firstMom1m) > 0.03) {
          strategies.filteredMomentum.n++;
          if (won) strategies.filteredMomentum.wins++;
          strategies.filteredMomentum.totalPnl += pnl;

          // Aligned variant: strong 1-min momentum AND the slower 5-min timeframe
          // pointing the same way. Longer timeframe acts as confirmation.
          const m5 = r.firstMom5m;
          if (typeof m5 === 'number' && m5 !== 0 && (m5 > 0) === (r.firstMom1m > 0)) {
            strategies.alignedMomentum.n++;
            if (won) strategies.alignedMomentum.wins++;
            strategies.alignedMomentum.totalPnl += pnl;
          }
        }
      }
    }

    // Strategy 2: always bet the market's own favorite
    if (hasBid) {
      const side = r.firstYesBid > 50 ? 'yes' : 'no';
      const entry = side === 'yes' ? r.firstYesAsk : r.firstNoAsk;
      if (entry != null) {
        const won = (side === 'yes' && r.result === 'yes') || (side === 'no' && r.result === 'no');
        const cost = entry / 100;
        const pnl = won ? (1 - cost) : -cost;
        strategies.favorite.n++;
        if (won) strategies.favorite.wins++;
        strategies.favorite.totalPnl += pnl;
      }
    }

    // Strategy 3: only trade when momentum agrees with the favorite
    if (hasMom && hasBid) {
      const momSaysUp = r.firstMom1m > 0;
      const favSaysUp = r.firstYesBid > 50;
      if (momSaysUp === favSaysUp) {
        const side = momSaysUp ? 'yes' : 'no';
        const entry = side === 'yes' ? r.firstYesAsk : r.firstNoAsk;
        if (entry != null) {
          const won = (side === 'yes' && r.result === 'yes') || (side === 'no' && r.result === 'no');
          const cost = entry / 100;
          const pnl = won ? (1 - cost) : -cost;
          strategies.agreement.n++;
          if (won) strategies.agreement.wins++;
          strategies.agreement.totalPnl += pnl;
        }
      }
    }
    // Strategy 4: bet AGAINST the divergence flag's direction
    if (r.divergenceSeen && r.divergenceDirection) {
      const side = r.divergenceDirection === 'up' ? 'no' : 'yes'; // opposite of what divergence said
      const entry = side === 'yes' ? r.firstYesAsk : r.firstNoAsk;
      if (entry != null) {
        const won = (side === 'yes' && r.result === 'yes') || (side === 'no' && r.result === 'no');
        const cost = entry / 100;
        const pnl = won ? (1 - cost) : -cost;
        strategies.antiDivergence.n++;
        if (won) strategies.antiDivergence.wins++;
        strategies.antiDivergence.totalPnl += pnl;
      }
    }
  }

  return strategies;
}

// Individual settled trades, newest first, for the live feed.
function recentTrades(limit) {
  const log = loadLog();
  const out = [];
  for (const r of Object.values(log)) {
    if (r.result !== 'yes' && r.result !== 'no') continue;
    const hasMom = typeof r.firstMom1m === 'number' && r.firstMom1m !== 0;
    const hasBid = r.firstYesBid != null;

    const push = (label, side) => {
      const entry = side === 'yes' ? r.firstYesAsk : r.firstNoAsk;
      if (entry == null) return;
      const won = (side === 'yes' && r.result === 'yes') || (side === 'no' && r.result === 'no');
      const cost = entry / 100;
      out.push({
        strategy: label,
        side,
        won,
        entry,
        pnl: won ? (1 - cost) : -cost,
        closeTime: r.closeTime,
        ticker: r.ticker
      });
    };

    if (hasMom && Math.abs(r.firstMom1m) > 0.03) {
      const m5 = r.firstMom5m;
      if (typeof m5 === 'number' && m5 !== 0 && (m5 > 0) === (r.firstMom1m > 0)) {
        push('Aligned momentum', r.firstMom1m > 0 ? 'yes' : 'no');
      }
    }
    if (r.divergenceSeen && r.divergenceDirection) {
      push('Anti-divergence', r.divergenceDirection === 'up' ? 'no' : 'yes');
    }
    if (hasMom && hasBid && (r.firstMom1m > 0) === (r.firstYesBid > 50)) {
      push('Agreement', r.firstMom1m > 0 ? 'yes' : 'no');
    }
  }
  out.sort((a, b) => new Date(b.closeTime) - new Date(a.closeTime));
  return out.slice(0, limit || 12);
}

